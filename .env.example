# Copy this file to .env for local development.  On Render, add the same
# values in Dashboard -> Environment; do not commit your real .env file.
SECRET_KEY=replace-with-a-long-random-production-secret
DEBUG=False
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
ALLOWED_HOSTS=your-service.onrender.com
CSRF_TRUSTED_ORIGINS=https://your-service.onrender.com
SECURE_SSL_REDIRECT=True
# Attach a Render persistent disk at /var/data, then use it for uploads.
MEDIA_ROOT=/var/data/media
# Created/promoted by: python manage.py provision_admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-long-password
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@aparthub.local
